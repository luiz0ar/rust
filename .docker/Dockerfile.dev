FROM rust:1-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install cargo-watch for live reload during development
RUN cargo install cargo-watch

WORKDIR /app

ENV HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

# Watch for file changes, ignoring local SQLite database files to prevent infinite reload loops
CMD ["cargo", "watch", "-i", "sqlite.db*", "-x", "run"]
